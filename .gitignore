# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/frontend/.next/
/out/
/frontend/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# example settings for connecting to the backend
!.env.example

# Downloaded feed media and generated import reports
/frontend/public/media/fbook/
/backend/prisma/fixtures/fbook/listings.json
/backend/prisma/fixtures/fbook/images.json
/backend/prisma/fixtures/fbook/*-report.json
/backend/prisma/fixtures/fbook/curl-downloads.conf
/backend/.local/
/frontend/public/media/dealertrade/

# Service account keys (never commit)
/backend/.secrets/

# Local database dumps, archives and client handover packages (never commit)
*.dump
*.zip
/client-handover/
/superadmin-client/

# Separate customer-view frontend repository
/change-cars-frontend/
