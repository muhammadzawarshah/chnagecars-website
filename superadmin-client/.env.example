# Docker Compose: copy to .env and fill all secrets, or run node scripts/setup.mjs.
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
WEB_ADAPTER_KEY=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
MINIO_ROOT_USER=review-storage
MINIO_ROOT_PASSWORD=
# Fresh isolated review database only. false = reference data + superadmin, no sample inventory.
SEED_REVIEW_DEMO=true
# Set these to your public HTTPS addresses on a server.
PUBLIC_WEB_URL=http://localhost:3000
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/changecars-media
S3_PUBLIC_ENDPOINT=http://localhost:9000
SESSION_COOKIE_SECURE=false
WEB_PORT=3000
API_PORT=4000
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
MAIL_PORT=8025
# For running Next.js directly (Docker supplies the internal address automatically):
API_URL=http://localhost:4000/api/v1
# Optional: existing public website for preview links; leave empty when reviewing just admin.
NEXT_PUBLIC_SITE_URL=
