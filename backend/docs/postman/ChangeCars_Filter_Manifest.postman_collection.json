{
  "info": {
    "name": "ChangeCars - Filter Manifest",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "origin",
      "value": "https://chnagecars-website-production.up.railway.app"
    },
    {
      "key": "snapshotUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Current manifest",
      "request": {
        "method": "GET",
        "url": "{{origin}}/api/v1/vehicle-filters/manifest"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Manifest 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200){const m=pm.response.json();pm.collectionVariables.set('snapshotUrl',pm.collectionVariables.get('origin')+m.snapshot_url);pm.test('Checksum metadata',()=>{pm.expect(m.sha256).to.match(/^[a-f0-9]{64}$/);pm.expect(m.compressed_bytes).to.be.above(0);});}"
            ]
          }
        }
      ]
    },
    {
      "name": "Download immutable gzip - save response to file",
      "request": {
        "method": "GET",
        "url": "{{snapshotUrl}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Snapshot 200',()=>pm.response.to.have.status(200));",
              "pm.test('Explicit gzip transport',()=>pm.expect(pm.response.headers.get('Content-Type')).to.include('application/gzip'));"
            ]
          }
        }
      ]
    }
  ]
}
