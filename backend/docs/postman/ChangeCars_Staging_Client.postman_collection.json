{
  "info": {
    "name": "ChangeCars Staging - Client Data Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Public data requests for https://changecarapi.wowcar.co.th. No credentials required. Run Vehicles page 1 before Vehicle detail to populate vehicleId. Lists report counts in meta.total; website response formats differ. Counts are live and may change. Featured website records use image; standard vehicle records use primaryImageUrl. Detail requests can increment view counts."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://changecarapi.wowcar.co.th"
    },
    {
      "key": "vehicleId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "item": [
        {
          "name": "Server health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/health/live"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Database readiness",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/health/ready"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Vehicles and counts",
      "item": [
        {
          "name": "Vehicles - page 1",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/vehicles?page=1&pageSize=20"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.length) pm.collectionVariables.set(\"vehicleId\", body.data[0].id);",
                  "console.log(\"Total public vehicles:\", body.meta && body.meta.total);"
                ]
              }
            }
          ]
        },
        {
          "name": "Total public vehicle count",
          "request": {
            "method": "GET",
            "header": [
