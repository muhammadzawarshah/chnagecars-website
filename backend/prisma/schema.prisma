// ChangeCars — PostgreSQL schema (source of truth for all transactional data).
// Connection URL lives in prisma.config.ts (Prisma 7). Raw SQL additions
// (check constraints, partial/trigram indexes) live in the migrations folder.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  CUSTOMER
  DEALER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Province {
  EASTERN_CAPE
  FREE_STATE
  GAUTENG
  KWAZULU_NATAL
  LIMPOPO
  MPUMALANGA
  NORTHERN_CAPE
  NORTH_WEST
  WESTERN_CAPE
}

enum DealerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DealerPlan {
  BASIC
  SILVER
  GOLD
}

enum DealerMemberRole {
  OWNER
  MANAGER
  SALES
  STAFF
}

enum DealerMemberStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum DealerPermission {
  DEALER_PROFILE_MANAGE
  BRANCHES_MANAGE
  STAFF_MANAGE
  INVENTORY_VIEW
  INVENTORY_MANAGE
  INVENTORY_PUBLISH
  ENQUIRIES_VIEW
  ENQUIRIES_RESPOND
  LEADS_VIEW_ALL
  LEADS_MANAGE_ALL
  LEADS_MANAGE_ASSIGNED
  LEADS_ASSIGN
  BIDDING_VIEW
  BIDDING_PARTICIPATE
  REPORTS_VIEW
}

enum VehicleCondition {
  NEW
  USED
  DEMO
}

enum VehicleStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  RESERVED
  SOLD
  SUSPENDED
  ARCHIVED
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  PLUGIN_HYBRID
  ELECTRIC
  LPG
  OTHER
}

enum Drivetrain {
  FWD
  RWD
  AWD
  FOUR_X_TWO
  FOUR_X_FOUR
}

enum FeatureAvailability {
  STANDARD
  OPTIONAL
}

enum ImageStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  FAILED
}

enum EnquiryType {
  VEHICLE
  QUOTE
  BEAT_MY_QUOTE
  TRADE_IN
  CONCIERGE
  HELP_ME_FIND
  FINANCE
  INSURANCE
  TEST_DRIVE
  GENERAL
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
  CANCELLED
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATION
  OFFER_SENT
  WON
  LOST
}

enum LeadSource {
  WEBSITE_ENQUIRY
  QUOTE_REQUEST
  TRADE_IN
  OFFER_ACCEPTED
  PHONE
  WHATSAPP
  EMAIL
  WALK_IN
  OTHER
}

enum LeadActivityType {
  NOTE
  CALL
  EMAIL
  SMS
  WHATSAPP
  MEETING
  STAGE_CHANGE
  ASSIGNMENT
  FOLLOW_UP_SET
  SYSTEM
}

enum SellMediaKind {
  PHOTO
  REGISTRATION_DOCUMENT
}

enum SellRequestType {
  SELL
  VALUATION
}

enum SellRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  VALUED
  BIDDING
  OFFER_ACCEPTED
  COMPLETED
  CANCELLED
  REJECTED
}

enum ConditionGrade {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

enum ValuationMethod {
  AUTOMATED
  MANUAL
}

enum BiddingStatus {
  SCHEDULED
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

enum OfferStatus {
  SUBMITTED
  PENDING
  UPDATED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
  SUPERSEDED
}

enum CounterOfferStatus {
