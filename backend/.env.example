# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_NAME=ChangeCars
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Number of proxies (Nginx / load balancer / CDN) in front of the API, for correct client IPs
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
SWAGGER_ENABLED=true

# ─── PostgreSQL (source of truth) ──────────────────────
DATABASE_URL=postgresql://changecars:changecars@localhost:5432/changecars?schema=public
DATABASE_POOL_MAX=20
# Optional read replica for public search/listing reads
# DATABASE_READ_URL=postgresql://changecars:changecars@replica:5432/changecars

# ─── Redis (cache, rate limits, view counters) ─────────
# Required when running more than one API instance
REDIS_URL=redis://localhost:6379

# ─── Auth ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
BCRYPT_ROUNDS=12

# ─── Rate limiting (per IP, default bucket) ────────────
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
# Same value as WEB_ADAPTER_KEY in the website (frontend/.env.local)
WEB_ADAPTER_KEY=change-me-shared-secret-with-the-website-at-least-32-chars

# ─── Object storage (S3 / R2 / MinIO) ──────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=af-south-1
S3_BUCKET=changecars-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Public (CDN) base URL for media
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/changecars-media
MEDIA_MAX_IMAGE_BYTES=15728640
MEDIA_MAX_IMAGES_PER_VEHICLE=40

# ─── Email / SMS ───────────────────────────────────────
MAIL_FROM=ChangeCars <no-reply@changecars.co.za>
# smtp://user:pass@smtp.example.com:587 — leave empty to log emails instead of sending
SMTP_URL=
SMS_PROVIDER=log

# ─── Background worker ─────────────────────────────────
# true = run outbox dispatcher + scheduled jobs inside the API process (dev only)
RUN_WORKER_IN_API=false
WORKER_OUTBOX_BATCH=50
WORKER_OUTBOX_POLL_MS=1000

# ─── Business rules ────────────────────────────────────
RESERVATION_HOLD_HOURS=72
BIDDING_MAX_DURATION_HOURS=168
