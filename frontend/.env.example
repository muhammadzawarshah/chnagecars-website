# ChangeCars API (backend/). Without API_URL the site runs on its built-in sample data.
API_URL=http://localhost:4000/api/v1
# Same value as WEB_ADAPTER_KEY in backend/.env (lets the API rate-limit per visitor).
WEB_ADAPTER_KEY=change-me-shared-secret-with-the-website-at-least-32-chars
# Address of the separately hosted super admin app (superadmin/). Super admins are sent there
# after login; without it they use the admin console on this site.
SUPERADMIN_URL=http://localhost:3001
